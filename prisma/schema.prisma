// GoList.me Prisma schema
// Standalone product. Do not import models or conventions from Photos 4 Real Estate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum PlatformRole {
  SUPERADMIN
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DELETED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String
  name          String?
  image         String?
  emailVerified DateTime?
  avatarUrl     String?

  platformRole PlatformRole @default(USER)
  status       UserStatus   @default(ACTIVE)

  // Remembers the workspace the user last worked in (for login and switching).
  lastActiveWorkspaceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      WorkspaceMembership[]
  ownedWorkspaces  RealtorWorkspace[]    @relation("WorkspaceOwner")
  invitationsSent  Invitation[]          @relation("InvitesBy")
  realtorProfiles  RealtorProfile[]      @relation("ProfileUser")
  creditEntries    CreditTransaction[]
  paymentsMade     Payment[]             @relation("PaymentInitiatedBy")
  passwordResets   PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  qrCodesCreated   QRCode[]              @relation("QRCodesCreatedBy")
  accounts         Account[]
  sessions         Session[]
}

// ---------------------------------------------------------------------------
// Workspace (customer and billing boundary)
// ---------------------------------------------------------------------------

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WorkspaceRole {
  OWNER
  ASSISTANT
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum Permission {
  MANAGE_LISTINGS
  GENERATE_MARKETING
  VIEW_LEADS
  VIEW_ANALYTICS
  PURCHASE_CREDITS
}

model RealtorWorkspace {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  status WorkspaceStatus @default(ACTIVE)

  // Primary realtor / business profile used on generated assets.
  firstName    String?
  lastName     String?
  email        String?
  phone        String?
  headshot     String?
  companyName  String?
  companyLogo  String?
  brandColor   String?
  websiteUrl   String?
  facebookUrl  String?
  linkedinUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  twitterUrl   String?
  pinterestUrl String?
  vimeoUrl     String?
  tiktokUrl    String?

  ownerUserId String
  owner       User   @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])

  stripeCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        WorkspaceMembership[]
  invitations        Invitation[]
  listings           Listing[]
  inquiries          PropertyInquiry[]
  realtorProfiles    RealtorProfile[]
  creditBalance      WorkspaceCreditBalance?
  creditTransactions CreditTransaction[]
  payments           Payment[]
  generationJobs     GenerationJob[]
  sellerReportLinks  SellerReportLink[]

  @@index([ownerUserId])
  @@index([status])
}

model WorkspaceMembership {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   RealtorWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  role        WorkspaceRole    @default(ASSISTANT)
  permissions Permission[]     @default([])
  status      MembershipStatus @default(ACTIVE)

  invitedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   RealtorWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  email       String
  role        WorkspaceRole @default(ASSISTANT)
  permissions Permission[]  @default([])
  tokenHash   String        @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?

  invitedById String
  invitedBy   User   @relation("InvitesBy", fields: [invitedById], references: [id])

  createdAt DateTime @default(now())

  @@index([workspaceId, status])
  @@index([email, status])
}

// Display-only co-realtor profile. Never grants access to a workspace or listing.
model RealtorProfile {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   RealtorWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("ProfileUser", fields: [userId], references: [id], onDelete: SetNull)

  firstName    String
  lastName     String
  email        String?
  phone        String?
  headshot     String?
  companyName  String?
  companyLogo  String?
  websiteUrl   String?
  facebookUrl  String?
  linkedinUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  twitterUrl   String?
  pinterestUrl String?
  vimeoUrl     String?
  tiktokUrl    String?

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings ListingCoRealtor[]

  @@index([workspaceId])
}

model ListingCoRealtor {
  id               String         @id @default(cuid())
  listingId        String
  listing          Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  realtorProfileId String
  realtorProfile   RealtorProfile @relation(fields: [realtorProfileId], references: [id], onDelete: Cascade)
  sortOrder        Int            @default(0)

  @@unique([listingId, realtorProfileId])
  @@index([realtorProfileId])
}

// ---------------------------------------------------------------------------
// Listings
// ---------------------------------------------------------------------------

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
}

model Listing {
  id        String           @id @default(cuid())
  // The workspace id is stored in realtorId to keep existing queries working.
  realtorId String
  realtor   RealtorWorkspace @relation(fields: [realtorId], references: [id], onDelete: Cascade)

  slug   String        @unique
  status ListingStatus @default(DRAFT)

  publishedAt DateTime?
  soldAt      DateTime?
  archivedAt  DateTime?

  // Property info
  propertyAddress          String
  propertyFormattedAddress String?
  propertyLat              Float?
  propertyLng              Float?
  propertyCity             String?
  propertyProvince         String?
  propertyPostalCode       String?
  propertyCountry          String?
  propertyPlaceId          String?

  // Public display overrides (do not affect map/location)
  propertyAddressOverride    String?
  propertyCityOverride       String?
  propertyPostalCodeOverride String?

  propertySize Int?
  yearBuilt    Int?
  mlsNumber    String?
  listPrice    Int?
  bedrooms     String?
  bathrooms    String?
  featuresText String?
  description  String?

  // Media relations
  photos        Photo[]
  videos        Video[]
  floorPlans    FloorPlan[]
  attachments   Attachment[]
  embeds        Embed[]
  propertyPages PropertyPage[]
  inquiries     PropertyInquiry[]
  reels         OrderReel[]
  reelSources   OrderReelSourceImage[]
  flyers        OrderFlyer[]
  socialPosts   OrderSocialPost[]
  qrAssignments QRAssignment[]
  coRealtors    ListingCoRealtor[]
  generationJobs GenerationJob[]
  sellerReportLinks SellerReportLink[]
  analyticsEvents   AnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([realtorId, status])
  @@index([status, publishedAt])
  @@index([createdAt])
}

model Photo {
  id      String  @id @default(cuid())
  orderId String
  order   Listing @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url     String
  urlMls  String?
  filename  String
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  @@index([orderId, sortOrder])
}

model Video {
  id        String   @id @default(cuid())
  orderId   String
  order     Listing  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model FloorPlan {
  id        String   @id @default(cuid())
  orderId   String
  order     Listing  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Attachment {
  id        String   @id @default(cuid())
  orderId   String
  order     Listing  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Embed {
  id        String   @id @default(cuid())
  orderId   String
  order     Listing  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title     String
  embedUrl  String
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Generated assets
// ---------------------------------------------------------------------------

enum ReelStatus {
  QUEUED
  RENDERING
  COMPLETE
  FAILED
  CANCELLED
}

enum AssetType {
  REEL
  SLIDESHOW
  FLYER
  SOCIAL_POST
  VIDEO
  QR_PRINTABLE
  PAGE_IMAGE
}

model GenerationJob {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   RealtorWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  orderId String?
  order   Listing? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  assetType AssetType
  provider  String    @default("remotion")
  status    ReelStatus @default(QUEUED)

  costCredits Int     @default(0)
  attempt     Int     @default(1)
  externalId  String?
  error       String?
  outputUrl   String?

  idempotencyKey String @unique

  createdByUserId String?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reels        OrderReel[]
  flyers       OrderFlyer[]
  socialPosts  OrderSocialPost[]
  creditEntries CreditTransaction[]

  @@index([workspaceId, status])
  @@index([orderId])
  @@index([assetType, status])
}

model OrderReel {
  id      String  @id @default(cuid())
  orderId String
  order   Listing @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantKey String
  provider   String
  renderId   String
  status     ReelStatus
  url        String?
  thumbnail  String?
  width      Int?
  height     Int?
  error      String?

  musicTrackId String?
  musicTrack   VideoMusicTrack? @relation(fields: [musicTrackId], references: [id])

  jobId      String?
  job        GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  isCurrent   Boolean  @default(true)
  version     Int      @default(1)
  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, status])
  @@index([musicTrackId])
  @@index([jobId])
}

model VideoMusicTrack {
  id        String           @id @default(cuid())
  name      String
  fileUrl   String
  duration  Float
  genre     String?
  mood      String?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  reels     OrderReel[]
  templates VideoTemplate[]

  @@index([isActive])
}

model VideoTemplate {
  id                  String           @id @default(cuid())
  variantKey          String           @unique
  provider            String           @default("remotion")
  status              String           @default("draft")
  name                String
  description         String?
  width               Int
  height              Int
  fps                 Float            @default(30)
  durationInFrames    Int
  compositionId       String
  schemaJson          Json?
  defaultMusicTrackId String?
  defaultMusicTrack   VideoMusicTrack? @relation(fields: [defaultMusicTrackId], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status, provider])
}

model OrderReelSourceImage {
  id        String   @id @default(cuid())
  orderId   String
  order     Listing  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([orderId, sortOrder])
}

model OrderFlyer {
  id      String  @id @default(cuid())
  orderId String
  order   Listing @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantKey String
  status     ReelStatus
  url        String?
  previewUrl String?
  pageWidth  Int?
  pageHeight Int?
  error      String?

  jobId      String?
  job        GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  isCurrent   Boolean  @default(true)
  version     Int      @default(1)
  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, status])
  @@index([jobId])
}

model SocialPostTemplate {
  id          String   @id @default(cuid())
  variantKey  String   @unique
  status      String   @default("draft")
  name        String
  description String?
  label       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model OrderSocialPost {
  id      String  @id @default(cuid())
  orderId String
  order   Listing @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantKey String
  status     ReelStatus
  url        String?
  width      Int?
  height     Int?
  error      String?

  jobId      String?
  job        GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  isCurrent   Boolean  @default(true)
  version     Int      @default(1)
  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, status])
  @@index([orderId, variantKey])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Public pages, leads, QR tracking
// ---------------------------------------------------------------------------

model PropertyPage {
  id      String  @id @default(cuid())
  orderId String
  order   Listing @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template      Int
  urlPath       String
  published     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  qrAssignments QRAssignment[]

  @@index([orderId])
  @@index([urlPath])
}

enum LeadSource {
  WEBSITE
  QR_CODE
  BOOK_SHOWING
  MORTGAGE_CALCULATOR
  HOME_WORTH
  SIMILAR_HOMES
}

model PropertyInquiry {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   RealtorWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  orderId String
  order   Listing @relation(fields: [orderId], references: [id], onDelete: Cascade)

  name    String
  email   String
  phone   String?
  message String?
  source  LeadSource @default(WEBSITE)

  qrAssignmentId String?
  qrAssignment   QRAssignment? @relation(fields: [qrAssignmentId], references: [id])

  createdAt DateTime @default(now())

  @@index([qrAssignmentId])
  @@index([workspaceId, createdAt])
  @@index([orderId, createdAt])
}

model SellerReportLink {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   RealtorWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderId     String
  order       Listing          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  tokenHash    String    @unique
  expiresAt    DateTime?
  revokedAt    DateTime?
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([orderId])
  @@index([workspaceId])
}

model AnalyticsEvent {
  id          String  @id @default(cuid())
  orderId     String
  order       Listing @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        String
  path        String?
  sessionHash String?
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([type, createdAt])
}

enum QRCodeStatus {
  UNASSIGNED
  ACTIVE
  ARCHIVED
}

model QRCode {
  id              String       @id @default(cuid())
  seq             Int          @unique @default(autoincrement())
  displayId       String       @unique
  status          QRCodeStatus @default(UNASSIGNED)
  createdByUserId String
  createdByUser   User         @relation("QRCodesCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  assignments QRAssignment[]
  printables  QRPrintable[]

  @@index([status])
}

model QRAssignment {
  id             String        @id @default(cuid())
  qrCodeId       String
  qrCode         QRCode        @relation(fields: [qrCodeId], references: [id])
  orderId        String
  order          Listing       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  propertyPageId String?
  propertyPage   PropertyPage? @relation(fields: [propertyPageId], references: [id])
  sendWeeklyStats Boolean      @default(true)
  assignedAt     DateTime      @default(now())
  unassignedAt   DateTime?

  scans QRScanEvent[]
  leads PropertyInquiry[]

  @@index([qrCodeId, unassignedAt])
  @@index([orderId])
}

model QRScanEvent {
  id           String       @id @default(cuid())
  assignmentId String
  assignment   QRAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  scannedAt    DateTime     @default(now())
  sessionHash  String
  userAgent    String?

  @@index([assignmentId, scannedAt])
}

model QRPrintable {
  id         String     @id @default(cuid())
  qrCodeId   String
  qrCode     QRCode     @relation(fields: [qrCodeId], references: [id])
  variantKey String
  status     ReelStatus @default(QUEUED)
  svgUrl     String?
  pngUrl     String?
  pdfUrl     String?
  error      String?
  createdAt  DateTime   @default(now())

  @@unique([qrCodeId, variantKey])
  @@index([qrCodeId, status])
}

// ---------------------------------------------------------------------------
// Credits and payments (Stripe)
// ---------------------------------------------------------------------------

enum CreditTransactionType {
  WELCOME_GRANT
  PURCHASE
  REFERRAL_GRANT
  ADMIN_GRANT
  GENERATION_RESERVATION
  GENERATION_DEDUCTION
  GENERATION_REFUND
  ADJUSTMENT
  EXPIRATION
}

model CreditTransaction {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   RealtorWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type        CreditTransactionType
  amount      Int
  description String?

  relatedPaymentId String?
  payment          Payment? @relation(fields: [relatedPaymentId], references: [id], onDelete: SetNull)

  relatedGenerationJobId String?
  generationJob          GenerationJob? @relation(fields: [relatedGenerationJobId], references: [id], onDelete: SetNull)

  idempotencyKey String @unique

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([userId])
  @@index([relatedGenerationJobId])
}

model WorkspaceCreditBalance {
  workspaceId String           @id
  workspace   RealtorWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  balance     Int              @default(0)
  updatedAt   DateTime         @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

model Payment {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   RealtorWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  initiatedByUserId String
  initiatedBy        User   @relation("PaymentInitiatedBy", fields: [initiatedByUserId], references: [id])

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique

  amountCents      Int
  currency         String @default("cad")
  creditsPurchased Int

  status PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditTransactions CreditTransaction[]

  @@index([workspaceId, status])
  @@index([status, createdAt])
}

model StripeWebhookEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  status        String    @default("received")
  error         String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([type, createdAt])
}

// ---------------------------------------------------------------------------
// Auth.js adapter models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}
